<figure class="diagram-frame" aria-labelledby="clock-state-caption">
  <svg viewBox="0 0 720 300" role="img" aria-labelledby="clock-state-title clock-state-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="clock-state-title">Proposed O2AT clock acquisition and reference-loss lifecycle</title>
    <desc id="clock-state-desc">An open session may acquire a valid local or disciplined clock. Start is allowed only after timing and the required source relationship are valid. Valid bounded holdover may continue. Invalid timing, exhausted holdover, or a missing playout packet causes local mute or abort, followed by a fresh session after recovery.</desc>
    <defs><marker id="state-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9z" fill="#087b83"/></marker><marker id="stop-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9z" fill="#9b4b3c"/></marker></defs>
    <g font-family="Avenir Next,Avenir,sans-serif" fill="#14272d" text-anchor="middle">
      <rect x="22" y="94" width="105" height="58" rx="3" fill="#eef4f3" stroke="#b7c9c9"/><text x="74" y="119" font-size="14">OPEN</text><text x="74" y="138" font-size="10" fill="#52666c">session may acquire</text>
      <rect x="180" y="94" width="125" height="58" rx="3" fill="#eef4f3" stroke="#7ea5a5"/><text x="242" y="119" font-size="14">CLOCK VALID</text><text x="242" y="138" font-size="10" fill="#52666c">relationship checked</text>
      <rect x="360" y="94" width="105" height="58" rx="3" fill="#e4f1ee" stroke="#087b83"/><text x="412" y="119" font-size="14">START</text><text x="412" y="138" font-size="10" fill="#52666c">then prefill</text>
      <rect x="520" y="94" width="105" height="58" rx="3" fill="#e4f1ee" stroke="#087b83"/><text x="572" y="119" font-size="14">RUNNING</text><text x="572" y="138" font-size="10" fill="#52666c">local conversion</text>
      <rect x="520" y="215" width="105" height="58" rx="3" fill="#f8eeeb" stroke="#9b4b3c"/><text x="572" y="240" font-size="14">MUTE / ABORT</text><text x="572" y="259" font-size="10" fill="#52666c">local protection</text>
      <rect x="345" y="215" width="125" height="58" rx="3" fill="#f4f1eb" stroke="#bd6a27"/><text x="407" y="240" font-size="14">HOLDOVER</text><text x="407" y="259" font-size="10" fill="#52666c">only within declared bound</text>
      <rect x="180" y="215" width="125" height="58" rx="3" fill="#eef4f3" stroke="#b7c9c9"/><text x="242" y="240" font-size="14">RECOVERY</text><text x="242" y="259" font-size="10" fill="#52666c">new session required</text>
    </g>
    <path d="M127 123H180M305 123H360M465 123H520" stroke="#087b83" stroke-width="2.5" marker-end="url(#state-arrow)"/><text x="332" y="108" font-family="monospace" font-size="10" text-anchor="middle" fill="#52666c">valid START</text>
    <path d="M572 152V215" stroke="#9b4b3c" stroke-width="2.5" marker-end="url(#stop-arrow)"/><text x="588" y="187" font-family="monospace" font-size="10" fill="#9b4b3c">invalid / timeout</text>
    <path d="M520 238H470" stroke="#bd6a27" stroke-width="2" marker-end="url(#state-arrow)"/><text x="494" y="225" font-family="monospace" font-size="9" text-anchor="middle" fill="#92531f">reference loss</text>
    <path d="M345 244C306 244 298 190 242 153" fill="none" stroke="#087b83" stroke-width="2" marker-end="url(#state-arrow)"/><text x="308" y="193" font-family="monospace" font-size="9" fill="#52666c">reference restored</text>
    <path d="M407 215C421 176 496 157 520 132" fill="none" stroke="#087b83" stroke-width="2" marker-end="url(#state-arrow)"/><text x="470" y="177" font-family="monospace" font-size="9" fill="#52666c">valid bounded holdover</text>
  </svg>
  <figcaption id="clock-state-caption" class="diagram-caption">A status message must not delay local protection or authorise an automatic restart. After mute or abort, establish a fresh session.</figcaption>
</figure>
