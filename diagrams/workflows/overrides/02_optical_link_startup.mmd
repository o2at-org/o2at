---
config:
  theme: mc
---
flowchart LR
    accTitle: Common optical Ethernet link startup
    accDescr: Confirm both SFP modules and qualified optics, enable transmitters only when compatible, establish a full-duplex 1G link, then permit o2at discovery while audio remains muted.
    Power["Sequence host and module power; keep audio muted"] --> Present{"SFP present at both ends?"}
    Present L_Present_Absent_0@-- No --> Absent["Report absent module; wait for insertion"]
    Absent L_Absent_Present_0@--> Present
    Present L_Present_Qualified_0@-- Yes --> Qualified{"Matched, qualified 1000BASE-SX optics and fibre?"}
    Qualified -- No --> Unsupported["Keep optical transmission disabled; report incompatibility"]
    Qualified L_Qualified_Enable_0@-- Yes --> Enable["Enable optical transmitters; monitor loss of signal and faults"]
    Enable --> Signal{"Both optical paths available without a module fault?"}
    Signal -- No --> Repair["Report optical fault; retain safe mute"]
    Repair L_Repair_Signal_0@--> Signal
    Signal L_Signal_PCS_0@-- Yes --> PCS["Establish 1000BASE-X PCS/PMA at 1.25 GBd"]
    PCS --> Negotiate["Enable auto-negotiation; advertise full duplex"]
    Negotiate --> Link{"1G full-duplex link established?"}
    Link -- No --> LinkFault["Report link fault; keep audio muted"]
    LinkFault L_LinkFault_Negotiate_0@--> Negotiate
    Link L_Link_Report_0@-- Yes --> Report["Report link speed, duplex and module diagnostics"]
    Report --> Discover["Permit o2at HELLO discovery"]

    Discover@{ shape: rounded }
    style Power fill:#FFCDD2
    style Discover fill:#C8E6C9
    style Unsupported fill:#FFCDD2
    style Repair fill:#FFCDD2
    style LinkFault fill:#FFCDD2
    linkStyle 2 stroke:#D50000,fill:none
    linkStyle 3 stroke:#00C853,fill:none
    linkStyle 4 stroke:#D50000,fill:none
    linkStyle 5 stroke:#00C853,fill:none
    linkStyle 7 stroke:#D50000,fill:none
    linkStyle 9 stroke:#00C853,fill:none
    linkStyle 12 stroke:#D50000,fill:none
    linkStyle 14 stroke:#00C853,fill:none

    L_Present_Absent_0@{ animation: slow }
    L_Absent_Present_0@{ animation: slow }
    L_Present_Qualified_0@{ animation: slow }
    L_Qualified_Enable_0@{ animation: slow }
    L_Repair_Signal_0@{ animation: slow }
    L_Signal_PCS_0@{ animation: slow }
    L_LinkFault_Negotiate_0@{ animation: slow }
    L_Link_Report_0@{ animation: slow }
