    style Foreign fill:#FCE8E6,stroke:#B3261E,color:#54201C
    style Rules fill:#E3F2E7,stroke:#25834A,color:#163D25
    style Discard fill:#FCE8E6,stroke:#B3261E,color:#54201C
    style Stage fill:#E3F2E7,stroke:#25834A,color:#163D25
    style Commit fill:#E3F2E7,stroke:#25834A,color:#163D25
    style Playback fill:#E3F2E7,stroke:#25834A,color:#163D25
